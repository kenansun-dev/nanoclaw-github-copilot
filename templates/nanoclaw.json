{
  "agents": {
    "defaults": {
      "model": "github-copilot/claude-sonnet-4",
      "name": "Andy",
      "mode": "sandbox",
      "sandboxBackend": "docker"
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    },
    "teams": {
      "enabled": false
    }
  },
  "chats": {},
  "mcp": {
    "servers": {}
  },
  "skills": {
    "directories": [
      "./skills"
    ],
    "disabled": []
  },
  "sandbox": {
    "runtime": "docker",
    "image": "nanoclaw-agent:latest",
    "timeout": 1800000,
    "maxConcurrent": 5,
    "idleTimeout": 0
  },
  "security": {
    "autoApproveChats": false
  },
  "credentialProxy": {
    "port": 3001
  },
  "logLevel": "info"
}
