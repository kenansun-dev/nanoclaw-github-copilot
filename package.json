{
  "name": "nanoclaw-github-copilot",
  "version": "1.2.19",
  "description": "AI assistant that runs agents in secure containers, powered by GitHub Copilot SDK",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onecli-sh/sdk": "^0.2.0",
    "better-sqlite3": "^11.8.1",
    "botbuilder": "^4.23.3",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "grammy": "^1.39.3",
    "mcporter": "^0.7.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nanoclaw": "./bin/nanoclaw.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenans/nanoclaw-github-copilot"
  },
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "github-copilot",
    "nanoclaw",
    "chatbot",
    "telegram",
    "teams"
  ],
  "author": "kenansun",
  "license": "MIT",
  "files": [
    ".copilot/skills/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bin/",
    "container/Dockerfile",
    "container/Dockerfile.ghc",
    "container/agent-runner-ghc/package-lock.json",
    "container/agent-runner-ghc/package.json",
    "container/agent-runner-ghc/src/",
    "container/agent-runner-ghc/tsconfig.json",
    "container/agent-runner/package-lock.json",
    "container/agent-runner/package.json",
    "container/agent-runner/src/",
    "container/agent-runner/tsconfig.json",
    "container/skills/",
    "dist/",
    "docs/*.md",
    "install.ps1",
    "install.sh",
    "scripts/setup-teams.ps1",
    "scripts/setup-teams.sh",
    "templates/"
  ]
}