{
  "name": "nanoclaw-github-copilot",
  "version": "0.0.2",
  "description": "AI assistant that runs agents in secure containers, powered by GitHub Copilot SDK",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "tsc && node scripts/copy-proto.mjs && bash container/shared/sync.sh && cd container/agent-runner-ghc && npm ci --no-audit --no-fund && node ../../scripts/verify-copilot-install.mjs . && npx tsc && cd mcp-servers/pdf && npx tsc && cd ../../../.. && cd container/agent-runner && npm ci --no-audit --no-fund && node ../../scripts/verify-copilot-install.mjs . && npx tsc",
    "build:runners": "cd container/agent-runner-ghc && npm ci --no-audit --no-fund && node ../../scripts/verify-copilot-install.mjs . && npx tsc && cd mcp-servers/pdf && npx tsc && cd ../../../.. && cd container/agent-runner && npm ci --no-audit --no-fund && node ../../scripts/verify-copilot-install.mjs . && npx tsc",
    "prepack": "npm run build && npm run build:runners && node scripts/strip-sourcemaps.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pretypecheck": "node scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "preinstall": "node scripts/preinstall-backup.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@onecli-sh/sdk": "^0.3.1",
    "better-sqlite3": "^11.8.1",
    "botbuilder": "^4.23.3",
    "chat": "^4.26.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "grammy": "^1.39.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nanoclaw": "./bin/nanoclaw.js",
    "ncl": "./bin/ncl.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenans/nanoclaw-github-copilot"
  },
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "github-copilot",
    "nanoclaw",
    "chatbot",
    "telegram",
    "teams"
  ],
  "author": "kenansun",
  "license": "MIT",
  "files": [
    ".copilot/skills/",
    "proto/",
    "scripts/copy-proto.mjs",
    "scripts/verify-copilot-install.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bin/",
    "container/Dockerfile",
    "container/Dockerfile.ghc",
    "container/build.sh",
    "container/entrypoint.sh",
    "container/entrypoint-ghc.sh",
    "container/assets/",
    "container/agent-runner-ghc/dist/",
    "container/agent-runner-ghc/mcp-servers/",
    "container/agent-runner-ghc/package-lock.json",
    "container/agent-runner-ghc/package.json",
    "container/agent-runner-ghc/src/",
    "container/agent-runner-ghc/tsconfig.json",
    "container/agent-runner/dist/",
    "container/agent-runner/package-lock.json",
    "container/agent-runner/package.json",
    "container/agent-runner/src/",
    "container/agent-runner/tsconfig.json",
    "container/skills/",
    "dist/",
    "docs/*.md",
    "install.ps1",
    "install.sh",
    "scripts/postinstall.mjs",
    "scripts/preinstall-backup.mjs",
    "scripts/read-credential.ps1",
    "scripts/setup-teams.ps1",
    "scripts/setup-teams.sh",
    "templates/"
  ]
}
